@namespace Service.UI.CMS.Blazor.Components.Shares.Filter
@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using Service.UI.CMS.Blazor.Components.Shares.Cards

<SurfaceCard Class="@($"search-panel {Class}")">
    <HeaderContent>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h2>@Title</h2>
        }
    </HeaderContent>

    <HeaderActions>
        @if (HeaderActionsContent is not null)
        {
            @HeaderActionsContent
        }
    </HeaderActions>

    <ChildContent>
        <div class="search-grid basic-grid">
            @BasicFields
        </div>

        @if (ShowAdvanced && AdvancedFields is not null)
        {
            <div class="search-grid advanced-grid">
                @AdvancedFields
            </div>
        }

        @if (Actions is not null || (HeaderActionsContent is null && AdvancedFields is not null))
        {
            <div class="search-actions @ActionsClass">
                @Actions
                @if (HeaderActionsContent is null && AdvancedFields is not null)
                {
                    <FluentButton Appearance="Appearance.Outline" @onclick="ToggleAdvanced">
                        @(ShowAdvanced ? HideAdvancedText : ShowAdvancedText)
                    </FluentButton>
                }
            </div>
        }
    </ChildContent>
</SurfaceCard>

<style>
    .search-panel {
        width: 100% !important;
        display: block !important;
        overflow: visible !important;
        contain: none !important;
    }

    .search-panel h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
    }

    .search-grid {
        display: grid;
        gap: 12px;
        margin-top: 8px;
        overflow: visible;
        width: 100%;
    }

    .search-grid > div {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
        min-width: 0;
    }

    .basic-grid {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .advanced-grid {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        padding-top: 12px;
        border-top: 1px dashed #d9e0ee;
        justify-items: start;
        align-items: start;
    }

    .advanced-grid > div {
        align-items: flex-start;
        justify-content: flex-start;
        text-align: left;
    }

    .search-panel label {
        display: block;
        margin: 0;
        color: #39435a;
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .search-panel fluent-text-field,
    .search-panel fluent-select,
    .search-panel fluent-combobox,
    .search-panel fluent-date-picker,
    .search-panel fluent-autocomplete,
    .search-panel fluent-search {
        width: 100%;
        --height: 32px;
    }

    .search-panel fluent-checkbox {
        margin-right: auto;
        justify-content: flex-start;
    }

    .search-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed #d9e0ee;
    }

    .search-actions.actions-center {
        justify-content: center;
    }

    @@media (max-width: 768px) {
        .search-actions {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }
    }
</style>
