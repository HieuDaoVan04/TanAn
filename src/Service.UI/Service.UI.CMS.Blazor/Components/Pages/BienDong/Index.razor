@page "/bien-dong"
@using Service.UI.CMS.Blazor.Components.Shared
@using Service.UI.CMS.Blazor.Components.Shares.Filter

<PageTitle>Quản Lý Biến Động Dân Cư - Xã Tân An</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="width:100%">
    <h2>Danh sách biến động dân cư</h2>

    <SearchPanel Title="Bộ lọc biến động dân cư">
        <BasicFields>
            <FluentSearch aria-label="Tìm kiếm"
                          Placeholder="Nhập vào từ khóa (Tên nhân khẩu, CCCD, nơi đi/đến...)"
                          @bind-Value="searchKeyword"
                          @bind-Value:after="LoadData"
                          Style="width: 100%;" />
        </BasicFields>
        <Actions>
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Search())" OnClick="LoadData">Tìm kiếm</FluentButton>
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size20.ArrowSync())" OnClick="ClearSearch">Tải lại</FluentButton>
        </Actions>
    </SearchPanel>

    <FluentStack Orientation="Orientation.Horizontal" Style="display:flex; justify-content:space-between; align-items:center;" Class="page-toolbar">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Class="page-toolbar">
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.AddCircle())" OnClick="@(() => showCreate = true)">Thêm mới</FluentButton>
            <FluentButton OnClick="ExportExcel" Appearance="Appearance.Accent" Class="ms-2">
                <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
            </FluentButton>
        </FluentStack>
    </FluentStack>

    <div class="data-grid-scroll">
        <FluentDataGrid Items="@bienDongQuery"
                        TGridItem="BienDongDto"
                        Pagination="@pagination"
                        ShowHover="true"
                        MultiLine="true"
                        RowSize="DataGridRowSize.Large"
                        GridTemplateColumns="50px 120px minmax(140px,1.2fr) 120px 110px minmax(120px,1fr) minmax(140px,1.5fr) 110px"
                        Style="width:100%;"
                        RowStyle="@(item => "min-height:60px;")">
            <ChildContent>
                <TemplateColumn Title="#" Sortable="false" Style="display: flex;align-items: center;">
                    @(bienDongQuery?.ToList().IndexOf(context) + 1)
                </TemplateColumn>
                <PropertyColumn Property="@(b => BusinessCreateDialog.Label(b.LoaiBienDong.ToString()))" Title="Loại Biến Động" Sortable="true" />
                <TemplateColumn Title="Họ tên nhân khẩu" Sortable="true" Style="display: flex;align-items: center;">
                    <span @onclick="@(() => detail = context)" style="cursor: pointer; color: dodgerblue; font-weight: 500;">
                        @context.HoTenNhanKhau
                    </span>
                </TemplateColumn>
                <PropertyColumn Property="@(b => b.CCCDNhanKhau)" Title="Số CCCD" />
                <PropertyColumn Property="@(b => b.NgayPhatSinh.ToString("dd/MM/yyyy"))" Title="Ngày Phát Sinh" />
                <PropertyColumn Property="@(b => b.NoiDenOrDi)" Title="Nơi Đi / Đến" />
                <PropertyColumn Property="@(b => b.LyDo)" Title="Lý Do" />
                <PropertyColumn Property="@(b => b.CanBoGhiNhan)" Title="Cán Bộ Ghi Nhận" />
            </ChildContent>
            <EmptyContent><p style="padding:20px">Không có dữ liệu phù hợp.</p></EmptyContent>
        </FluentDataGrid>
    </div>

    <Paginator PaginationState="@pagination" SelectedPageSizeChanged="RefreshData" />
</FluentStack>

@if(showCreate) { <BusinessCreateDialog Kind="change" Saved="Created" Cancel="@(() => showCreate = false)" /> }
@if(detail != null)
{
    <DataDialog Title="Chi tiết biến động dân cư" Close="@(() => detail = null)">
        <dl><dt>Nhân khẩu</dt><dd>@detail.HoTenNhanKhau</dd><dt>CCCD</dt><dd>@detail.CCCDNhanKhau</dd><dt>Loại biến động</dt><dd>@BusinessCreateDialog.Label(detail.LoaiBienDong.ToString())</dd><dt>Ngày phát sinh</dt><dd>@detail.NgayPhatSinh.ToString("dd/MM/yyyy")</dd><dt>Nơi đi / đến</dt><dd>@detail.NoiDenOrDi</dd><dt>Lý do</dt><dd>@detail.LyDo</dd><dt>Cán bộ ghi nhận</dt><dd>@detail.CanBoGhiNhan</dd></dl>
        <div class="dialog-actions"><FluentButton OnClick="@(() => detail = null)">Đóng</FluentButton></div>
    </DataDialog>
}
