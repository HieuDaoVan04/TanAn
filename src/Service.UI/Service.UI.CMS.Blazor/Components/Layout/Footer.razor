@using Microsoft.FluentUI.AspNetCore.Components
@inherits LayoutComponentBase
@implements IDisposable
@inject Service.UI.CMS.Blazor.Applications.SystemConfigurationState Configuration

@if (Configuration.Value.FooterEnabled)
{
<p style="margin: 0;">
    Version @Configuration.Value.AppVersion
</p>
<FluentSpacer />
<p style="margin: 0;">
    @Configuration.Value.FooterContent © @DateTime.Now.Year.
    @if (!string.IsNullOrWhiteSpace(Configuration.Value.SupportEmail)) { <span> · @Configuration.Value.SupportEmail</span> }
    @if (!string.IsNullOrWhiteSpace(Configuration.Value.Hotline)) { <span> · @Configuration.Value.Hotline</span> }
</p>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Configuration.Changed += Refresh;
        await Configuration.EnsureLoadedAsync();
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Configuration.Changed -= Refresh;
}

<style>
    footer {
        background: var(--neutral-layer-4);
        color: var(--neutral-foreground-rest);
        align-items: center;
        padding: 10px 16px;
        display: flex;
    }

    footer a {
        color: var(--neutral-foreground-rest);
        text-decoration: none;
    }

    footer a:focus {
        outline: 1px dashed;
        outline-offset: 3px;
    }

    footer a:hover {
        text-decoration: underline;
    }
</style>
