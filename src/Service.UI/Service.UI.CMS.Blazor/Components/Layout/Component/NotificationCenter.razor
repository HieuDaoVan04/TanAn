@using Microsoft.FluentUI.AspNetCore.Components
@using Service.UI.CMS.Blazor.Applications
@implements IDisposable
@inject IDialogService DialogService
@inject IMessageService MessageService

<FluentButton Appearance="Appearance.Stealth" OnClick="OpenNotificationCenterAsync" Title="Thông báo">
    @if ((villageUnread + MessageService.Count(AppRoutes.MESSAGES_NOTIFICATION_CENTER)) > 0)
    {
        <FluentCounterBadge Count="@(villageUnread + MessageService.Count(AppRoutes.MESSAGES_NOTIFICATION_CENTER))"
                            Max="9"
                            ShowOverflow="true"
                            BackgroundColor="@Color.Error"
                            Color="Color.Fill"
                            Appearance="Appearance.Accent">
            <ChildContent>
                <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" Color="Color.Neutral" Title="Thông báo" />
            </ChildContent>
        </FluentCounterBadge>
    }
    else
    {
        <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" Color="Color.Neutral" Title="Thông báo" />
    }
</FluentButton>
