@using Service.TanAn.Application.Interfaces
@using Service.Shared.Contracts.DTOs
@inject IAIService AIService
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="assistant-chat" aria-label="Hội thoại với trợ lý AI">
    <header class="chat-header">
        <div><span class="eyebrow">TÂN AN · TRỢ LÝ AI</span><h2>Hỗ trợ thủ tục của bạn</h2></div>
        <button type="button" class="quiet-button" disabled="@busy" @onclick="Reset">Hội thoại mới</button>
    </header>
    <div class="chat-status">
        <span class="status-dot"></span>
        @(status.GeminiConfigured ? "Đã cấu hình Gemini · có hướng dẫn dự phòng" : "Tra cứu hướng dẫn nội bộ")
    </div>
    <div class="chat-messages" @ref="messageContainer" role="log" aria-live="polite" aria-relevant="additions" aria-busy="@busy">
        <div class="welcome"><span class="bot-avatar" aria-hidden="true">AI</span><div><strong>Xin chào! Mình có thể hỗ trợ gì?</strong><p>Hỏi về dân cư, an sinh hoặc cách nộp và tra cứu hồ sơ trong hệ thống Tân An.</p></div></div>
        @foreach (var item in messages)
        {
            <article class="message @(item.IsUser ? "user" : "assistant")" @key="item">
                <div class="message-label">@(item.IsUser ? "Bạn" : "Trợ lý Tân An")</div>
                <div class="message-text">@item.Text</div>
                @if (item.Response is { } answer)
                {
                    <div class="answer-mode">@(answer.Mode == "gemini" ? "Gemini · dựa trên hướng dẫn nội bộ" : "Hướng dẫn nội bộ")</div>
                    @if (answer.Sources.Count > 0)
                    {
                        <details class="sources"><summary>Nguồn tham khảo (@answer.Sources.Count)</summary>
                            @foreach (var source in answer.Sources)
                            { <div><strong>@source.Title</strong><small>Phiên bản @source.Version · cập nhật @source.UpdatedOn</small></div> }
                        </details>
                    }
                    <p class="answer-notice">@answer.Notice</p>
                }
            </article>
        }
        @if (busy) { <div class="thinking" role="status">Đang tìm hướng dẫn phù hợp…</div> }
    </div>
    <div class="suggestions" aria-label="Câu hỏi gợi ý">
        @foreach (var suggestion in suggestions)
        { <button type="button" disabled="@busy" @onclick="() => Ask(suggestion)">@suggestion</button> }
    </div>
    @if (!string.IsNullOrEmpty(error)) { <div class="chat-error" role="alert">@error</div> }
    <form class="composer" @onsubmit="Send" @onsubmit:preventDefault>
        <label class="input-label" for="@inputId">Câu hỏi của bạn</label>
        <div class="input-row">
            <input id="@inputId" @bind="input" @bind:event="oninput" maxlength="4000" disabled="@busy" placeholder="Ví dụ: Đăng ký tạm trú cần chuẩn bị gì?" autocomplete="off" />
            <button type="submit" class="send-button" disabled="@(busy || string.IsNullOrWhiteSpace(input))">@(busy ? "Đang xử lý…" : "Gửi câu hỏi")</button>
        </div>
            
    </form>
</section>

@code {
    private readonly string inputId = "assistant-input-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource lifetime = new();
    private readonly List<Message> messages = new();
    private readonly List<AssistantConversationTurn> history = new();
    private string[] suggestions = ["Đăng ký khai sinh", "Đăng ký tạm trú", "Trợ cấp an sinh xã hội"];
    private AssistantStatusDto status = new();
    private string input = "", error = "";
    private bool busy, scrollPending, disposed;
    private ElementReference messageContainer;
    private IJSObjectReference? module;

    protected override void OnInitialized() => status = AIService.GetAssistantStatus();

    public Task AskQuestionAsync(string question) => Ask(question);

    private Task Ask(string question)
    {
        if (busy) return Task.CompletedTask;
        input = question;
        return Send();
    }

    private async Task Send()
    {
        if (busy || string.IsNullOrWhiteSpace(input)) return;
        if (input.Length > 4000) { error = "Câu hỏi tối đa 4.000 ký tự."; return; }
        var question = input.Trim();
        messages.Add(new(true, question));
        input = error = "";
        busy = scrollPending = true;
        try
        {
            var result = await AIService.ChatProcedureAsync(new() { Question = question, History = history.TakeLast(12).ToList() }, lifetime.Token);
            if (disposed) return;
            if (result.Success && result.Data is { } answer)
            {
                messages.Add(new(false, answer.Answer, answer));
                history.Add(new() { Role = "user", Text = question });
                history.Add(new() { Role = "model", Text = answer.Answer });
                if (history.Count > 12) history.RemoveRange(0, history.Count - 12);
                suggestions = (answer.RelatedProcedures ?? new()).Take(3).ToArray();
            }
            else { error = result.Message; input = question; }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { error = "Chưa thể gửi câu hỏi. Hãy thử lại."; input = question; }
        finally { busy = false; scrollPending = true; }
    }

    private void Reset()
    {
        if (busy) return;
        messages.Clear(); history.Clear(); input = error = "";
        suggestions = ["Đăng ký khai sinh", "Đăng ký tạm trú", "Trợ cấp an sinh xã hội"];
        scrollPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender) module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/assistant-chat.js");
            if (scrollPending && module != null) { scrollPending = false; await module.InvokeVoidAsync("scrollToLatest", messageContainer); }
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true; lifetime.Cancel(); lifetime.Dispose();
        if (module != null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }

    private sealed class Message(bool isUser, string text, ChatbotProcedureResponse? response = null)
    {
        public bool IsUser { get; } = isUser;
        public string Text { get; } = text;
        public ChatbotProcedureResponse? Response { get; } = response;
    }
}
